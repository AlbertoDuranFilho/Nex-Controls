{
  "kind": "collectionType",
  "collectionName": "produtos",
  "info": {
    "singularName": "produto",
    "pluralName": "produtos",
    "displayName": "Produto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "codigo": {
      "type": "string",
      "required": true
    },
    "descricao": {
      "type": "blocks"
    },
    "aplicacoes": {
      "type": "blocks"
    },
    "destaque": {
      "type": "string"
    },
    "compatibilidade": {
      "type": "string"
    },
    "imagens": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "manual": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "especificacoes": {
      "type": "component",
      "component": "produto.especificacao",
      "repeatable": true
    }
  }
}
