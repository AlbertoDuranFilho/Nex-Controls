# Copie para .env (não versionado). Só chaves PÚBLICAS: nunca a service role no app.
# URL do projeto Supabase (a mesma do site: NEXT_PUBLIC_SUPABASE_URL)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave publishable (sb_publishable_...) ou, em projetos antigos, a anon key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativa aceita se a de cima estiver vazia:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Origem do site, sem barra final (rota de notificar pedido e links).
EXPO_PUBLIC_SITE_URL=https://www.nexcontrols.com
