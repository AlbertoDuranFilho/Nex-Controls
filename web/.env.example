NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FEATURE_TROCA_SENHA=false
# Origem publica do site (sem barra final), usada no link do e-mail de troca de endereco.
# Obrigatoria em producao: sem ela a troca de e-mail e recusada. Em dev usa o host da requisicao.
NEXT_PUBLIC_SITE_URL=

RESEND_API_KEY=
EMAIL_REMETENTE=
EMAIL_PEDIDOS_DESTINO=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FEATURE_PAGAMENTO_ONLINE=false
FEATURE_NFE_AUTOMATICA=false
# NF-e automatica (Maino). Credenciais SO na Vercel (Production e Preview), nunca no repositorio.
# Com FEATURE_NFE_AUTOMATICA=true, as tres primeiras sao obrigatorias em producao (build guard).
# MAINO_APPLICATION_UID=
# MAINO_EMAIL=
# MAINO_SENHA=
# Opcionais (padrao entre parenteses):
# MAINO_API_URL=https://api.maino.com.br/api/v2
# Id da condicao de pagamento ativa na Maino (GET /condicoes_pagamento). Sem ele, o pedido vai sem cobranca.
# MAINO_CONDICAO_PAGAMENTO_ID=
# Numero da forma de pagamento da Maino (usado junto com a condicao).
# MAINO_FORMA_PAGAMENTO=
# Plano de conta da Maino (usado junto com a condicao).
# MAINO_PLANO_DE_CONTA=
# Modalidade do frete na NF-e (padrao 9 = sem frete).
# MAINO_MODALIDADE_FRETE=9
# Gancho de teste (e2e) para revalidar o cache do catalogo. Deixe vazio em producao.
REVALIDATE_SECRET=
